DATABASE_URL="postgresql://user:password@localhost:5432/eduplat"
AUTH_SECRET="generate-a-strong-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Production (next start): the site's public https URL. Required — the server
# refuses to start without it (http is accepted only for localhost).
# AUTH_URL=https://your-domain.example
# Optional public origin for certificate QR codes and reset links (defaults to AUTH_URL; must match it).
# APP_BASE_URL=https://your-domain.example
# Private uploads (videos, attachments). Required in production: absolute path on a
# persistent volume, outside the app directory and never inside public/.
# STORAGE_ROOT=/var/lib/eduplat/storage
# First admin account for `npm run db:seed` in production (required there, never printed).
# Remove both from the server's environment after seeding.
# SEED_TEACHER_EMAIL=admin@your-domain.example
# SEED_TEACHER_PASSWORD=
# Development only: where password-reset links are written instead of being emailed
# (default ./.dev-outbox). Never used in production.
# DEV_OUTBOX_DIR=
