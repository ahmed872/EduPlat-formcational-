DATABASE_URL="postgresql://user:password@localhost:5432/eduplat"
AUTH_SECRET="generate-a-strong-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Production (next start) behind your own host: let Auth.js trust it.
# AUTH_TRUST_HOST=true
# Optional public origin for certificate QR codes (defaults to NEXTAUTH_URL).
# APP_BASE_URL=https://your-domain.example
# Private uploads (videos, attachments). Absolute path on a persistent volume in production.
# STORAGE_ROOT=/var/lib/eduplat/storage
# First admin account for `npm run db:seed` in production (required there, never printed).
# SEED_TEACHER_EMAIL=admin@your-domain.example
# SEED_TEACHER_PASSWORD=
